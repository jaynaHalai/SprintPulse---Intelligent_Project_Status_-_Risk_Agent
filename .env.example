# ---------------------------------------------------------------------------
# SprintPulse configuration. Copy to .env and fill in what you need.
# The app runs with NO keys at all: analysis, memory and reports still work,
# using deterministic narrative and local embeddings. Keys upgrade the quality.
# ---------------------------------------------------------------------------

# --- Language model (optional but recommended) -----------------------------
# Provider: anthropic (default) or openai.
SPRINTPULSE_LLM_PROVIDER=anthropic
SPRINTPULSE_LLM_MODEL=claude-opus-5
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# SPRINTPULSE_LLM_MAX_TOKENS=8000
# Newer Claude models reject sampling parameters - only set this for models that accept it.
# SPRINTPULSE_LLM_TEMPERATURE=0

# --- Mem0 persistent memory ------------------------------------------------
# mode=oss   -> self-hosted Mem0 with a local Qdrant store (default, no key needed)
# mode=platform -> hosted Mem0; requires MEM0_API_KEY
MEM0_MODE=oss
# MEM0_API_KEY=
MEM0_VECTOR_PATH=.mem0_store
MEM0_COLLECTION=sprintpulse
# Local embedder, so memory needs no API key. Swap for openai to use theirs.
MEM0_EMBEDDER_PROVIDER=fastembed
MEM0_EMBEDDER_MODEL=BAAI/bge-small-en-v1.5
MEM0_EMBEDDING_DIMS=384
# Mem0 fact extraction needs an LLM; defaults to on only when an LLM key is set.
# MEM0_INFER=false

# --- Analysis thresholds ---------------------------------------------------
SPRINTPULSE_DATA_DIR=data
SPRINTPULSE_STALE_DAYS=5
SPRINTPULSE_BLOCKED_ESCALATION_DAYS=3
